{
  "openapi": "3.0.3",
  "info": {
    "title": "View Resource Catalog API",
    "description": "API for viewing the community resource catalog with optional filtering by category or resource name",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "{apiGatewayUrl}",
      "description": "API Gateway endpoint",
      "variables": {
        "apiGatewayUrl": {
          "default": "https://api.example.com/dev"
        }
      }
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Retrieve resource catalog",
        "description": "Fetches resources circulating in the community network with optional filtering by category or resource name",
        "operationId": "viewResourceCatalog",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Filter resources by category",
            "required": false,
            "schema": {
              "type": "string",
              "example": "produce"
            }
          },
          {
            "name": "resource",
            "in": "query",
            "description": "Filter resources by name (contains search)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Canned"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource catalog retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceCatalogResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResourceCatalogResponse": {
        "type": "object",
        "properties": {
          "resources": {
            "type": "array",
            "description": "List of resources matching the filter criteria",
            "items": {
              "$ref": "#/components/schemas/Resource"
            }
          },
          "count": {
            "type": "integer",
            "description": "Number of resources returned",
            "example": 3
          },
          "filters_applied": {
            "type": "object",
            "description": "Filters that were applied to the query",
            "properties": {
              "category": {
                "type": "string",
                "nullable": true,
                "example": "produce"
              },
              "resource": {
                "type": "string",
                "nullable": true,
                "example": "Canned"
              }
            }
          }
        }
      },
      "Resource": {
        "type": "object",
        "properties": {
          "resource_id": {
            "type": "string",
            "description": "Unique resource identifier",
            "example": "RES001"
          },
          "category": {
            "type": "string",
            "description": "Resource category",
            "example": "produce"
          },
          "resource": {
            "type": "string",
            "description": "Resource name",
            "example": "Canned vegetables"
          },
          "unit": {
            "type": "string",
            "description": "Unit the resource is measured in",
            "example": "can"
          },
          "perishable": {
            "type": "boolean",
            "description": "Whether the resource is perishable",
            "example": false
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "message": {
            "type": "string",
            "description": "Detailed error message"
          }
        }
      }
    }
  }
}
