          <mxGeometry x="200" y="540" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="modes" value="Runs in 3 modes (config.js):&#10;- Connected to AWS -&gt; the agent&#10;- Live backend data -&gt; API direct&#10;- Demo mode -&gt; mocked replies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D6B656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="610" width="240" height="80" as="geometry" />
