<mxfile host="app.diagrams.net" agent="Good Neighbor Agent" version="24.7.7">
  <diagram id="good-neighbor-arch" name="Good Neighbor Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" value="Good Neighbor Agent — Community Waste Recovery (AWS Architecture)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="1120" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== USER ===================== -->
        <mxCell id="user" value="Community member&#10;(browser)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="50" height="90" as="geometry" />
        </mxCell>

        <!-- ===================== HOSTING LAYER (Amplify + SPA) ===================== -->
        <mxCell id="hostGroup" value="Frontend hosting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="180" y="380" width="260" height="280" as="geometry" />
        </mxCell>
        <mxCell id="amplify" value="AWS Amplify Hosting&#10;(CI/CD + HTTPS + CDN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="210" y="420" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="spa" value="Static SPA&#10;index.html · app.js · styles.css&#10;(reads config.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="210" y="510" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="spaNote" value="Alt: S3 + CloudFront&#10;(launchAgent.sh path)" style="text;html=1;fontSize=10;align=center;fontColor=#7f6000;" vertex="1" parent="1">
          <mxGeometry x="210" y="600" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== IDENTITY (Cognito) ===================== -->
        <mxCell id="idGroup" value="Identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="380" width="230" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cognito" value="Amazon Cognito&#10;User Pool&#10;(passwordless EMAIL_OTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#232F3E;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="420" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cognitoNote" value="Sends OTP via COGNITO_DEFAULT email&#10;(no SES). Returns JWT access token." style="text;html=1;fontSize=10;align=center;fontColor=#8a2a2a;" vertex="1" parent="1">
          <mxGeometry x="510" y="495" width="210" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== AGENT RUNTIME ===================== -->
        <mxCell id="runtimeGroup" value="Agent runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="120" width="320" height="360" as="geometry" />
        </mxCell>
        <mxCell id="agentcore" value="Amazon Bedrock&#10;AgentCore Runtime&#10;(custom JWT authorizer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#232F3E;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="160" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="strands" value="Strands agent (agent.py)&#10;+ Claude on Amazon Bedrock&#10;grounded: only relays tool results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="820" y="250" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="identityVault" value="AgentCore Identity&#10;(outbound OAuth2 M2M token vault)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="820" y="340" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="avp" value="Amazon Verified Permissions&#10;(per-request tool filtering)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="820" y="405" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- ===================== GATEWAY ===================== -->
        <mxCell id="gateway" value="AgentCore Gateway (MCP)&#10;opens only authorized tool groups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=#232F3E;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="520" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== BACKEND (deployed) ===================== -->
        <mxCell id="beGroup" value="Backend tools — deployed SAM stack &#39;good-neighbor-backend&#39; (us-east-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="640" width="820" height="360" as="geometry" />
        </mxCell>
        <mxCell id="apigw" value="Amazon API Gateway (HTTP API)&#10;/ · /catalog · /needs · /pantry · /volunteers · /vehicles · /guidelines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CC2264;strokeColor=#232F3E;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="690" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lambda" value="AWS Lambda&#10;good-neighbor-backend&#10;(lambda_function.py routes by path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#232F3E;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="810" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="handlers" value="Tool handlers&#10;guidelines · community&#10;pantry · logistics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="810" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="data" value="Seed data (bundled JSON)&#10;resources · organizations · surplus&#10;needs · pantry · volunteers · vehicles · guidelines" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="1250" y="790" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ddbNote" value="Production: swap JSON for Amazon DynamoDB&#10;(LocationIndex / CapacityIndex GSIs) — isolated in common.load()" style="text;html=1;fontSize=10;align=center;fontColor=#5a3d7a;" vertex="1" parent="1">
          <mxGeometry x="1250" y="915" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== FLOW ARROWS ===================== -->
        <!-- 1. user -> SPA -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="user" target="spa">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e1lbl" value="1. open app" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="e1"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <!-- 2. SPA <-> Cognito -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1" source="spa" target="cognito">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e2lbl" value="2. email → OTP → JWT" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="e2"><mxGeometry x="-0.1" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <!-- 3. SPA -> AgentCore Runtime (JWT bearer) -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;" edge="1" parent="1" source="spa" target="agentcore">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e3lbl" value="3. InvokeAgentRuntime&#10;Authorization: Bearer JWT" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="e3"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <!-- runtime internal: agentcore -> strands -> identity -> avp -> gateway -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;" edge="1" parent="1" source="agentcore" target="strands">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e4lbl" value="4. run Claude" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="e4"><mxGeometry relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1;dashed=1;" edge="1" parent="1" source="strands" target="avp">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e5lbl" value="5. authorize tools" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="e5"><mxGeometry relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1;dashed=1;" edge="1" parent="1" source="strands" target="identityVault">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e6lbl" value="mint OAuth2 token" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="e6"><mxGeometry relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;" edge="1" parent="1" source="strands" target="gateway">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e7lbl" value="6. call tools (MCP)" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="e7"><mxGeometry relative="1" as="geometry" /></mxCell>
        </mxCell>
        <!-- 7. gateway -> API Gateway -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="gateway" target="apigw">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e8lbl" value="7. HTTPS (SigV4 / OAuth2)" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="e8"><mxGeometry relative="1" as="geometry" /></mxCell>
        </mxCell>
        <!-- backend internal -->
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="apigw" target="lambda">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e9lbl" value="8. invoke" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="e9"><mxGeometry relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="lambda" target="handlers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="handlers" target="data">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e11lbl" value="9. read" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="e11"><mxGeometry relative="1" as="geometry" /></mxCell>
        </mxCell>

        <!-- Direct demo path: SPA -> API Gateway (BACKEND_API_URL) -->
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3fb6e0;strokeWidth=2;dashed=1;" edge="1" parent="1" source="spa" target="apigw">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e12lbl" value="Demo path: BACKEND_API_URL&#10;(SPA calls backend directly)" style="edgeLabel;html=1;fontSize=10;fontColor=#1b6f92;" connectable="0" vertex="1" parent="e12"><mxGeometry x="-0.3" relative="1" as="geometry" /></mxCell>
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" value="Legend&#10;— solid: main request flow (browser → agent → tools)&#10;— dashed green: in-runtime authorization / token minting&#10;— dashed blue: optional demo path (frontend calls the deployed backend directly)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#cccccc;rounded=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="360" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
