<mxfile host="app.diagrams.net" agent="Good Neighbor Agent" version="24.7.7">
  <diagram id="good-neighbor-arch" name="Good Neighbor Architecture">
    <mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Good Neighbor Agent - Community Waste Recovery (deployed AWS architecture, us-east-1)" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="230" y="16" width="1240" height="34" as="geometry" />
        </mxCell>

        <mxCell id="user" value="Community member&#10;(browser)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="46" height="90" as="geometry" />
        </mxCell>

        <mxCell id="hostGroup" value="Frontend (static SPA - no build step)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="170" y="430" width="300" height="330" as="geometry" />
        </mxCell>
        <mxCell id="amplify" value="AWS Amplify Hosting&#10;(or S3 + CloudFront)&#10;HTTPS + CDN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1">
